mainmenu "zzb hvac sample"

rsource "../common/Kconfig"

choice SAMPLE_HVAC
	prompt "Device type"

config SAMPLE_THERMOSTAT
	bool "Thermostat (0x0301)"

config SAMPLE_HEATING_COOLING_UNIT
	bool "Heating/Cooling Unit (0x0300)"

config SAMPLE_AIR_PURIFIER
	bool "Air Purifier (0x0308)"

endchoice

config SAMPLE_DEVICE_ID
	hex
	default 0x0301 if SAMPLE_THERMOSTAT
	default 0x0300 if SAMPLE_HEATING_COOLING_UNIT
	default 0x0308 if SAMPLE_AIR_PURIFIER

# The highest Rev of the revision history of the device type in the DTL
config SAMPLE_DEVICE_VERSION
	int
	default 1

config SAMPLE_MODEL_ID
	string
	default "thermostat" if SAMPLE_THERMOSTAT
	default "heating_cooling_unit" if SAMPLE_HEATING_COOLING_UNIT
	default "air_purifier" if SAMPLE_AIR_PURIFIER

source "Kconfig.zephyr"
