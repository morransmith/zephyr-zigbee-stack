mainmenu "zzb pump sample"

rsource "../common/Kconfig"

choice SAMPLE_PUMP_TYPE
	prompt "Device type"

config SAMPLE_PUMP
	bool "Pump (0x0303)"

config SAMPLE_PUMP_CONTROLLER
	bool "Pump Controller (0x0304)"
	select SAMPLE_SLEEPY

endchoice

config SAMPLE_DEVICE_ID
	hex
	default 0x0303 if SAMPLE_PUMP
	default 0x0304 if SAMPLE_PUMP_CONTROLLER

# The highest Rev of the revision history of the device type in the DTL
config SAMPLE_DEVICE_VERSION
	int
	default 1

config SAMPLE_MODEL_ID
	string
	default "pump" if SAMPLE_PUMP
	default "pump_controller" if SAMPLE_PUMP_CONTROLLER

source "Kconfig.zephyr"
