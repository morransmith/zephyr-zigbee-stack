mainmenu "zzb ballast sample"

rsource "../common/Kconfig"

choice SAMPLE_BALLAST
	prompt "Device type"

config SAMPLE_ON_OFF_BALLAST
	bool "On/Off Ballast (0x0108)"

config SAMPLE_DIMMABLE_BALLAST
	bool "Dimmable Ballast (0x0109)"

endchoice

config SAMPLE_DEVICE_ID
	hex
	default 0x0108 if SAMPLE_ON_OFF_BALLAST
	default 0x0109 if SAMPLE_DIMMABLE_BALLAST

# The highest Rev of the revision history of the device type in the DTL
config SAMPLE_DEVICE_VERSION
	int
	default 1

config SAMPLE_MODEL_ID
	string
	default "on_off_ballast" if SAMPLE_ON_OFF_BALLAST
	default "dimmable_ballast" if SAMPLE_DIMMABLE_BALLAST

source "Kconfig.zephyr"
