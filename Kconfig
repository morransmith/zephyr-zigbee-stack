menuconfig ZZB
	bool "Zigbee stack"
	select NET_BUF
	select HWINFO
	select CRC
	select PSA_CRYPTO
	select PSA_WANT_KEY_TYPE_AES
	select PSA_WANT_ALG_ECB_NO_PADDING
	select PSA_WANT_ALG_CCM
	help
	  Zigbee PRO R22 stack with Base Device Behavior 3.0.1 and ZCL rev 8.

if ZZB

config ZZB_NODE_COUNT
	int "Maximum number of nodes"
	default 1

config ZZB_BUF_COUNT
	int "Frame buffers shared by all nodes"
	default 16

config ZZB_WORKQ_STACK_SIZE
	int "Stack thread stack size"
	default 4096
	help
	  The thread uses up to 2568 bytes on ESP32-H2, measured with an
	  application callback that calls printk().

config ZZB_WORKQ_PRIORITY
	int "Stack thread cooperative priority"
	default 8

config ZZB_KEY_CACHE_SIZE
	int "PSA keys imported at a time"
	default 4
	help
	  Entries of the PSA key cache shared by all nodes. Each entry holds one
	  PSA key slot.

config ZZB_MAC
	bool "MAC layer"
	default y
	depends on IEEE802154_RAW_MODE || NET_L2_CUSTOM_IEEE802154
	help
	  IEEE 802.15.4 MAC sublayer. Tests that fake the MAC turn it off.

config ZZB_NWK
	bool "NWK layer"
	default ZZB_MAC
	select SETTINGS
	help
	  Zigbee network layer. The application enables a settings backend for the
	  frame counter. Tests that fake NWK turn it off.

config ZZB_APS
	bool "APS sublayer"
	default ZZB_NWK
	select SETTINGS
	help
	  Zigbee application support sublayer. The application enables a settings
	  backend for the link keys and the frame counter. Tests that fake APS turn
	  it off.

config ZZB_APS_TX_COUNT
	int "APS transmissions in progress"
	range 1 32
	default 4
	help
	  Entries of the APS transmission table. Each APSDE-DATA.request takes
	  one until its confirm.

config ZZB_APS_DUP_COUNT
	int "APS duplicate rejection table entries"
	range 1 255
	default 8

config ZZB_APS_KEY_PAIR_COUNT
	int "Key-pair table entries"
	default 1
	help
	  Entries of apsDeviceKeyPairSet. An end device shares a link key only
	  with the trust center.

config ZZB_APS_BINDING_COUNT
	int "Binding table entries"
	range 1 255
	default 8
	help
	  Entries of apsBindingTable. ZDO Bind_req adds them, and APSDE-DATA
	  with binding sends to them.

config ZZB_APS_GROUP_COUNT
	int "Group table entries"
	range 1 255
	default 8
	help
	  Entries of apsGroupTable, one per group and endpoint. BDB 6.6 asks
	  for at least 8 memberships on a node that is not a sleepy end device.

config ZZB_ZDO
	bool "ZDO"
	default ZZB_APS
	help
	  Zigbee device object: the ZDO server, the ZDO client and the processing
	  of the APS key indications. Tests that fake ZDO turn it off.

config ZZB_BDB
	bool "BDB"
	default ZZB_ZDO
	help
	  Base Device Behavior: initialization, network steering, the trust
	  center link key exchange and the resets. Tests that fake BDB turn it
	  off.

config ZZB_ZCL
	bool "ZCL"
	default ZZB_BDB
	select SETTINGS
	help
	  Zigbee Cluster Library: the foundation commands and the Basic,
	  Identify and On/Off servers on the application endpoints. The
	  application enables a settings backend for the non-volatile
	  attributes. Tests that fake ZCL turn it off.

config ZZB_BDB_PRIMARY_CHANNELS
	hex "bdbPrimaryChannelSet"
	range 0 0x07fff800
	default 0x02108800
	help
	  Channels that network steering scans first, bit n for channel n. The
	  default holds channels 11, 15, 20 and 25 (BDB 5.3.8).

config ZZB_BDB_SECONDARY_CHANNELS
	hex "bdbSecondaryChannelSet"
	range 0 0x07fff800
	default 0x05ef7000
	help
	  Channels that network steering scans when it finds no network on the
	  primary channels. The default holds the other channels of 11 to 26.

config ZZB_ZDO_TRANSACTION_COUNT
	int "ZDO client transactions"
	range 1 32
	default 4
	help
	  Requests of the ZDO client that wait for their response at the same
	  time.

config ZZB_FRAME_COUNTER_JUMP
	int "Outgoing frame counter jump at boot"
	default 1024
	help
	  Distance between the outgoing frame counter and its saved watermark.
	  On boot the counter starts at the watermark, which moves by this value.

config ZZB_NEIGHBOR_COUNT
	int "Neighbor table entries"
	default 16

config ZZB_NWK_NETWORK_COUNT
	int "Networks reported by a network discovery"
	default 8

config ZZB_NWK_ED_TIMEOUT
	int "Requested Timeout Enumeration of the End Device Timeout Request"
	range 0 14
	default 8
	help
	  0 is 10 seconds, n from 1 to 14 is 2^n minutes. The default 8 is
	  nwkEndDeviceTimeoutDefault, 256 minutes.

config ZZB_NWK_PARENT_FAILURES
	int "Failed transmissions to the parent before a parent link failure"
	range 1 255
	default 3
	help
	  Consecutive frames and polls without an ACK from the parent, after
	  the MAC retries, before NLME-NWK-STATUS.indication reports parent
	  link failure.

endif # ZZB
